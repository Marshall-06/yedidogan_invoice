{
  "name": "label-zawod-backend",
  "version": "1.0.0",
  "main": "src/cmd/server.js",
  "bin": "src/cmd/server.js",
  "pkg": {
    "assets": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "public/**/*",
      "assets/**/*",
      "src/views/**/*",
      "src/config/**/*",
      "scripts/**/*",
      "sql/**/*",
      "src/models/**/*",
      "src/routers/**/*",
      "node_modules/swagger-ui-dist/**/*"
    ]
  },
  "scripts": {
    "start": "nodemon src/cmd/server.js",
    "start:prod": "node src/cmd/server.js",
    "dev": "node --watch --watch-path=src src/cmd/server.js",
    "fix-db": "node scripts/drop-invoice-plu-fk.js",
    "init-db": "node scripts/init-database.js",
    "repair-db": "node scripts/repair-database.js",
    "export-items": "node scripts/export-items.js",
    "import-items": "node scripts/import-items.js",
    "check-items": "node scripts/check-items.js",
    "build:exe": "pkg . --targets node16-win-x64 --output yedidogan-zawod.exe",
    "build:exe:modern": "pkg . --targets node18-win-x64 --output yedidogan-zawod.exe"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^7.18.3",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  }
} 