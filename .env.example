# ── Server ──
PORT=4000
# Windows Server 2022 (önümçilik): production
# Ösüş kompýuteri: development
NODE_ENV=production
CORS_ORIGIN=*

# ── PostgreSQL ──
DB_HOST=localhost
# Port: PostgreSQL gurnalan port (Services → PostgreSQL → Properties)
# Köp ýerde: 5432 (standart) ýa-da 5433. 5443 diňe öz gurnawyňyzda şeýle bolsa.
DB_PORT=5433
DB_NAME=yedidogan
DB_USER=postgres
DB_PASSWORD=gizlin
DB_LOGGING=false

# Ilkinji gezek serwerde:
#   init-db.bat  — bazany we tablisalary SQL bilen döret
# ýa-da pgAdmin-de: CREATE DATABASE yedidogan; soň sql/schema.sql işlediň

# ── JWT ──
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Bellik: taýýar admin döredilmeýär. Ilkinji /api/auth/register bilen
# özüň admin döredýärsiň (boş bazada ilkinji ulanyjy awtomatiki admin bolýar).

# ── Windows Server 2012 R2 / 2016 / 2022 ──
# exe: node16 (2012 R2 üçin) — npm run build:exe
# 1) .env-i exe bilen bir papkada saklaň
# 2) install-autostart.bat — Admin (awto başlatma)
# 3) start.vbs / stop.vbs




